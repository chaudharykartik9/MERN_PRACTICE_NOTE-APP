PORT=5000

# MongoDB (used by docker-compose and the API)
MONGO_USER=todo_user
MONGO_PASSWORD=change_me
MONGO_URI=mongodb://todo_user:change_me@localhost:27017/todo-app?authSource=admin

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
